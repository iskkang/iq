{
  "name": "landed-iq",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/check-build.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "check:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "check:edge": "npx -y deno@2 check --config supabase/functions/deno.json supabase/functions/classify/index.ts",
    "check:build": "tsx scripts/check-build.ts",
    "check": "tsc -b && npm run check:scripts && npm run check:edge && vitest run && oxlint",
    "bench": "tsx scripts/bench-500.ts",
    "golden": "tsx scripts/golden-run.ts",
    "seed:rates": "tsx supabase/seed/seed-rates.ts",
    "hts:fetch": "tsx scripts/fetch-hts-catalog.ts",
    "hts:seed": "tsx scripts/seed-hts-lines.ts",
    "hts:ch99": "tsx scripts/fetch-ch99.ts",
    "hts:301": "tsx scripts/fetch-301-lists.ts",
    "seed:301": "tsx scripts/seed-301.ts",
    "sample:build": "tsx scripts/build-sample-report.ts",
    "demo:record": "tsx scripts/record-demo.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/vite": "^4.3.3",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/browser": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
