{
  /*
   * scripts/ · tests/ · supabase/seed/ 타입체크.
   *
   * 이전에는 이 파일들이 **어떤 검사에도 걸리지 않았다.** tsconfig.app 은 src 만,
   * tsconfig.node 는 vite.config.ts 하나만 본다. tsx 는 타입을 지우고 실행하므로
   * 타입 오류가 3분짜리 LLM 실행 뒤 런타임에서야 터졌다 — golden-run.ts 처럼
   * 한 번 도는 데 비용과 시간이 드는 스크립트에서 이건 그대로 30분이 된다.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts", "tests", "supabase/seed"]
}
