#!/bin/sh
# push 전에 npm run check 를 돌린다 (약 40초).
#
# 왜 있는가: 이 저장소에서 산문으로만 남은 규칙은 어겨졌고 검사로 변환된 규칙은
# 지켜졌다. "커밋 전에 실제로 돌려봤는가" 도 문서일 뿐이라 같은 운명이었다 —
# 실제로 연속 두 커밋에서 어겨 CI 를 두 번 깨뜨렸다. 그래서 기계화한다.
#
# 활성화:  git config core.hooksPath .githooks
# 우회:    git push --no-verify   (긴급 시에만. CI 가 뒤에서 다시 잡는다)
echo "pre-push: npm run check …"
if ! npm run check; then
  echo ""
  echo "✗ npm run check 실패 — push 를 중단한다."
  echo "  긴급하면 git push --no-verify (CI 가 뒤에서 잡는다)"
  exit 1
fi
